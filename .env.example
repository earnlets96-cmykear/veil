# VEIL Environment Configuration Template
# Copy this file to .env and configure for your local/production environment.
# DO NOT commit real secrets or production credentials to git.

# Environment Mode: 'production' | 'development' | 'test'
VEIL_ENV=production

# Server Host & Binding
VEIL_HOST=0.0.0.0
VEIL_PORT=8443

# Envelope Storage & TTL Configuration
VEIL_MAX_ENVELOPE_TTL_SECONDS=604800
VEIL_MAX_MAILBOX_ENVELOPES=1000
VEIL_MAX_PAYLOAD_BYTES=65536

# Rate Limiting & Abuse Prevention
VEIL_RATE_LIMIT_BURST=100
VEIL_RATE_LIMIT_WINDOW_SECONDS=60

# Logging: 'error' | 'warn' | 'info'
VEIL_LOG_LEVEL=info

# Cloud & Account Infrastructure (Phase 27)
DATABASE_URL=file://.veil_cloud_db
OBJECT_STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
OBJECT_STORAGE_BUCKET=veil-encrypted-attachments
OBJECT_STORAGE_ACCESS_KEY=your_access_key_here
OBJECT_STORAGE_SECRET_KEY=your_secret_key_here
OBJECT_STORAGE_REGION=us-east-1
SESSION_SECRET=your_32_byte_session_secret_here
