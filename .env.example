# ==============================================================================
# VEIL PRODUCTION ENVIRONMENT CONFIGURATION
# Backend: Render (Node.js/TypeScript)
# Relational DB: Supabase (PostgreSQL)
# Object Storage: Cloudflare R2 (S3-Compatible)
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=10000
RELAY_PORT=10000
RELAY_HOST=0.0.0.0
RELAY_LOG_LEVEL=info

# Client Public Relay Endpoint (Vite & Capacitor)
# Canonical live Render deployment:
VITE_RELAY_URL=https://veil-rga0.onrender.com
VITE_RELAY_WS_URL=wss://veil-rga0.onrender.com/v1/ws

# Optional Custom Domain (requires DNS CNAME: relay.veil.chat -> veil-rga0.onrender.com)
# VITE_RELAY_URL=https://relay.veil.chat
# VITE_RELAY_WS_URL=wss://relay.veil.chat/v1/ws

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
# Direct or connection-pooled connection string from Supabase project settings
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yoursecurepassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 OBJECT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
R2_BUCKET=veil-attachments
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_REGION=auto

# Optional alias compatibility (Standard S3 variables)
# OBJECT_STORAGE_ENDPOINT=https://0123456789abcdef.r2.cloudflarestorage.com
# OBJECT_STORAGE_BUCKET=veil-attachments
# OBJECT_STORAGE_ACCESS_KEY=your_access_key_here
# OBJECT_STORAGE_SECRET_KEY=your_secret_key_here
# OBJECT_STORAGE_REGION=auto

# ------------------------------------------------------------------------------
# 3. CORS & SECURITY
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://veil-rga0.onrender.com,https://veil.chat,http://localhost:5173
