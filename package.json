{
  "name": "veil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VEIL: Privacy-First Messenger with Multi-Space Cryptographic Architecture",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/release-build.mjs",
    "build:release": "node scripts/release-build.mjs",
    "verify:release": "npm test && npm run build && node scripts/release-build.mjs",
    "preview": "vite preview",
    "relay": "node --import tsx/esm src/server/cli.ts",
    "start": "node --import tsx/esm src/server/cli.ts",
    "start:server": "node --import tsx/esm src/server/cli.ts",
    "tunnel": "node scripts/free-tunnel.mjs",
    "backup": "node scripts/production-backup.mjs --backup",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
