# Production Caddyfile for VEIL Cloud & Blind Relay Backend
# Domain: relay.veil.chat

relay.veil.chat {
    # Enforce modern TLS 1.3
    tls {
        protocols tls1.3
    }

    # Security Headers
    header {
        # Enforce HTTPS strictly
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "interest-cohort=()"
    }

    # Limit request body sizes (max 50MB for encrypted attachments)
    request_body {
        max_size 50MB
    }

    # Reverse proxy HTTP API & WebSocket endpoints to VEIL Backend service
    reverse_proxy veil-backend:8787 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # WebSocket support with long-lived timeouts
        transport http {
            read_buffer 8192
            write_buffer 8192
        }
    }

    # Logging
    log {
        output file /var/log/caddy/veil_relay_access.log {
            roll_size 50mb
            roll_keep 5
        }
        format json
    }
}
