# Example Caddyfile for VEIL Blind Relay Server
# Terminating TLS 1.3 and forwarding HTTP/WebSocket traffic to VEIL Relay

veil.example.com {
    # Automatic HTTPS with Let's Encrypt / ZeroSSL
    tls admin@example.com {
        protocols tls1.3
    }

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    # Request Body Size Limit (64 KiB max envelope payload + overhead)
    request_body {
        max_size 128KB
    }

    # Reverse proxy to local VEIL Relay daemon
    reverse_proxy 127.0.0.1:8787 {
        # WebSocket support is built into Caddy by default
        transport http {
            keepalive 30s
            keepalive_idle_conns 100
        }
    }

    # Access logging with private IP anonymization
    log {
        output file /var/log/caddy/veil_relay.log {
            roll_size 10MB
            roll_keep 5
        }
    }
}
