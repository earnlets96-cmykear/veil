# VEIL Relay Server Environment Configuration Template

# Server Listening Host & Port
RELAY_HOST=0.0.0.0
RELAY_PORT=8787

# Persistent Storage Path (stores blind mailbox metadata & opaque envelopes)
RELAY_STORAGE_DIR=/var/lib/veil/storage

# Log Level: none | error | warn | info | debug
RELAY_LOG_LEVEL=info

# Envelope Retention Time-To-Live (seconds, default: 14 days)
RELAY_DEFAULT_TTL_SECONDS=1209600

# Rate Limiting
RELAY_RATE_LIMIT_WINDOW_MS=60000
RELAY_MAX_REQUESTS_PER_WINDOW=100
